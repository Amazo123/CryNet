{
  // PlatformIO IDE — the hub project.
  //
  // These mirror firmware/hub_infer/.vscode/settings.json so that opening
  // the repository root works as well as opening firmware/hub_infer.
  //
  // The extension drives the PlatformIO Core in its own virtual environment
  // (~/.platformio/penv), which is version 6.2.0 — the same version the
  // command line uses. It shares the core directory ~/.platformio, where
  // ESP-IDF 6.1.0 and the Xtensa toolchain already live, so nothing is
  // downloaded and the IDE works with no network.
  "platformio-ide.useBuiltinPython": false,
  "platformio-ide.useBuiltinPIOCore": true,
  "platformio-ide.customPATH": "C:\\Users\\HP\\.platformio\\penv\\Scripts",
  "platformio-ide.autoOpenPlatformIOIniFile": false,
  "platformio-ide.monitorBaudRate": 115200,

  // The training notebook and the research scripts.
  "python.analysis.typeCheckingMode": "basic",
  "files.exclude": {
    "**/.pio": true,
    "**/__pycache__": true
  },
  "files.associations": {
    "*.ino": "cpp"
  },
  "cmake.sourceDirectory": "C:/Users/HP/.t3/projects/fp-2/firmware/hub_infer"
}
