# CryNet hub — ESP32-S3-DevKitC-1 (N16R8)

# Name
CONFIG_IDF_TARGET="esp32s3"

# Flash — 16 MB, quad IO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM — 8 MB octal at 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# Optimisation — ESP-IDF defaults to -Og (debug) and the front end, the
# FFT and the convnet are all compute-bound. -O2 with assertions still on.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# CPU clock — the ESP-IDF default for the S3 is 160 MHz here, but the
# DevKitC-1 runs the LX7 at 240 MHz and every stage of this firmware is
# compute-bound (the front end, the FFT and the convnet).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS — 2 timers extra, larger task stack for the inference task
CONFIG_FREERTOS_HZ=1000

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Bluetooth — the caregiver's phone connects to the hub over BLE.  NimBLE
# rather than Bluedroid: the hub is already using the Wi-Fi radio for
# ESP-NOW and the internal RAM for the front end's working buffers, and
# NimBLE is the smaller stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL=3

# BLE and Wi-Fi share the one radio, so software coexistence arbitrates
# the airtime between the ESP-NOW link and the BLE connection.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
